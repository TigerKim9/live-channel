# Application
APP_ENV=development
APP_NAME=LiveStation

# Backend
BACKEND_PORT=8080
BACKEND_HOST=0.0.0.0

# Frontend
REACT_APP_API_URL=http://localhost:8080
REACT_APP_WS_URL=ws://localhost:8080/ws
REACT_APP_RTMP_URL=rtmp://localhost:1935/live
REACT_APP_HLS_URL=http://localhost:8080/hls

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=livestation
POSTGRES_PASSWORD=livestation_password
POSTGRES_DB=livestation

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# SRS Media Server
SRS_HTTP_PORT=1985
SRS_RTMP_PORT=1935
SRS_HTTP_API_PORT=1985

# AWS (Production)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=livestation-recordings
AWS_CLOUDFRONT_DOMAIN=

# Storage
RECORDING_PATH=/var/recordings
HLS_PATH=/var/hls
THUMBNAIL_PATH=/var/thumbnails

# Transcoding
FFMPEG_THREADS=4
TRANSCODING_PROFILES=360p,480p,720p,1080p

# Time Machine
TIMEMACHINE_DURATION=21600
TIMEMACHINE_SEGMENT_DURATION=10

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=24h

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
